# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: TMDB Developer API Key for automatic poster and title enrichment
TMDB_API_KEY=

# Scraper & Crawler Configuration
CRAWLER_USER_AGENT=SceneFindBot/1.0 (+https://github.com/scenefind/indexer; respectful crawler)
CRAWL_INTERVAL_HOURS=12
CRAWL_DELAY_MS=1500

# App Settings
NODE_ENV=development
PORT=3000
